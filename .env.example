BEAUTYTPV_DEBUG=0
BEAUTYTPV_SECRET_KEY=
BEAUTYTPV_ALLOWED_HOSTS=localhost,127.0.0.1
BEAUTYTPV_FISCAL_ENVIRONMENT=TEST

# PEM files and backup encryption key stored outside the repository
BEAUTYTPV_AEAT_CERTIFICATE=
BEAUTYTPV_AEAT_PRIVATE_KEY=
BEAUTYTPV_BACKUP_KEY=
BEAUTYTPV_BACKUP_DIR=

# Trusted HTTPS reverse proxy on loopback only
BEAUTYTPV_TRUST_PROXY=0
BEAUTYTPV_CSRF_TRUSTED_ORIGINS=

# Esta plantilla NO se carga automaticamente como .env.
# Produccion: scripts/runtime.py carga instance.json externo con claves permitidas.
# Desarrollo: exportar variables de forma explicita en la sesion de PowerShell.
# DEMO: usar scripts/windows_demo.py; no reutilizar este archivo como config DEMO.
BEAUTYTPV_DB=
BEAUTYTPV_HSTS_SECONDS=31536000
BEAUTYTPV_BRIDGE_TOKEN=

# No existe variable que autorice produccion fiscal automaticamente.
# FISCAL_PRODUCTION_APPROVED permanece bloqueado en el codigo y exige evidencias.
